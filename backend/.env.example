NODE_ENV=production
PORT=4000
DB_PATH=./data/weddings.db
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
IP_HASH_SALT=
ALLOWED_ORIGINS=https://www.your-domain.com
# Hops in front of the API: the Next.js proxy (1). Do not raise unless you add more trusted proxies.
TRUST_PROXY=1
# Creates/updates the admin on start (min 12 chars). Remove after first start if you like.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=
