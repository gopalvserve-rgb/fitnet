{
  "name": "vows7-weddings",
  "private": true,
  "scripts": {
    "local": "node scripts/start-local.mjs",
    "db:dump": "npm --prefix backend run db:dump --",
    "install:all": "npm --prefix backend install && npm --prefix frontend install && npm install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test:api": "npm --prefix backend test",
    "test:e2e": "playwright test",
    "test": "npm run test:api && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
